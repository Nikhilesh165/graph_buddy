# Copy to .env and fill in. Shared by docker-compose (Neo4j credentials) and
# the backend (backend/app/core/config.py resolves this file at the repo root).

# --- Neo4j / Graphiti ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- LLM (extraction, chat) ---
ANTHROPIC_API_KEY=
# Optional: pin a specific Claude model. Leave unset to use graphiti-core's default.
ANTHROPIC_MODEL=

# --- Embeddings (Graphiti's OpenAI embedder; see docs/ARCHITECTURE.md §5) ---
OPENAI_API_KEY=

# --- Backend ---
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
