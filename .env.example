# Copy to .env and fill in. Shared by docker-compose (Neo4j credentials) and
# the backend (backend/app/core/config.py resolves this file at the repo root).

# --- Neo4j / Graphiti ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- OpenAI: inference (extraction, ontology proposals, chat) AND embeddings
# -- one provider, one key. See docs/ARCHITECTURE.md §5. ---
OPENAI_API_KEY=
# Both default to graphiti-core's own current model constant when unset --
# leave commented out unless you want to pin something else (an uncommented
# but empty value is NOT the same as unset and will break the LLM calls).
# OPENAI_MODEL=
# OPENAI_ONTOLOGY_MODEL=

# --- Backend ---
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]

# --- Memory + AI-driven discovery (docs/MEMORY_AND_DISCOVERY.md). All
# optional; defaults shown. ---
# How much the AI may change the ontology without review:
# manual | assisted | autonomous (renames/removals always wait for review).
# ONTOLOGY_AUTONOMY=autonomous
# AUTO_DISCOVER_ON_UPLOAD=true
# Extract each upload into the graph right after discovery (one LLM call
# per chunk -- off by default).
# AUTO_EXTRACT_ON_UPLOAD=false
# QUERY_RESOLUTION_ENABLED=true
# MEMORY_WORKING_TURNS=6
# MEMORY_RECALL_K=3
# Periodic consolidation; 0 disables the schedule (manual trigger still works).
# CONSOLIDATION_INTERVAL_MINUTES=360
# CONSOLIDATION_BUILD_COMMUNITIES=true
